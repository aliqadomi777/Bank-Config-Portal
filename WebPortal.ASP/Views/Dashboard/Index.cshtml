@using WebPortal.ASP.Resources

@{
    ViewBag.Title = Resources.Dashboard;
}

<style>

    .dashboard-options {
        max-width: 900px;
        margin: 0 auto;
    }

    .dashboard-row {
        direction: ltr;
    }

    .dashboard-option {
        text-align: center;
        padding: 30px 20px;
        margin-bottom: 20px;
    }

        .dashboard-option .btn {
            min-width: 180px;
        }
</style>


<div class="title">

    <h2>
        @Resources.Dashboard - @Session["BankName"]
    </h2>

</div>


<div class="dashboard-options">

    <div class="row dashboard-row">

        <div class="col-md-6">

            <div class="panel panel-default dashboard-option">

                @Html.ActionLink(
                    Resources.ManageBranches,
                    "Index",
                    "Branch",
                    null,
                    new
                    {
                        @class = "btn btn-primary"
                    })

            </div>

        </div>


        <div class="col-md-6">

            <div class="panel panel-default dashboard-option">

                @Html.ActionLink(
                    Resources.ManageServices,
                    "Index",
                    "Service",
                    null,
                    new
                    {
                        @class = "btn btn-primary"
                    })

            </div>

        </div>

    </div>

</div>