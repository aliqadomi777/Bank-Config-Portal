@using WebPortal.ASP.Resources

@{
    ViewBag.Title = Resources.Dashboard;
}


<div class="title">

    <h2>
        @Resources.Dashboard
    </h2>

</div>


<div class="dashboard-options">

    <div class="row dashboard-row">

        <div class="col-md-6">

            <div class="panel panel-default dashboard-option">

                @Html.ActionLink(
                    Resources.ManageBranches,
                    "Index",
                    "Branch",
                    null,
                    new
                    {
                        @class = "btn btn-primary"
                    })

            </div>

        </div>


        <div class="col-md-6">

            <div class="panel panel-default dashboard-option">

                @Html.ActionLink(
                    Resources.ManageServices,
                    "Index",
                    "Service",
                    null,
                    new
                    {
                        @class = "btn btn-primary"
                    })

            </div>

        </div>

    </div>

</div>