@model WebPortal.ASP.Models.ServiceViewModel
@using WebPortal.ASP.Resources

@if (TempData["Error"] != null)
{
    <div class="alert alert-info">
        @TempData["Error"]
    </div>
}

@{
    ViewBag.Title = Model.ServiceId == 0
        ? Resources.AddService
        : Resources.EditService;

    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .service-form {
        max-width: 700px;
        margin: 30px auto;
    }

        .service-form .panel-body {
            padding: 25px;
        }

        .service-form .form-group {
            margin-bottom: 20px;
        }

        .service-form .control-label {
            white-space: nowrap;
        }

        .service-form .arabic-input {
            direction: rtl;
            text-align: right;
        }

        .service-form .form-actions {
            margin-top: 25px;
            text-align: right;
        }

            .service-form .form-actions .btn {
                min-width: 90px;
                margin-left: 5px;
            }
</style>


<div class="panel panel-default service-form">

    <div class="panel-heading">

        <h3 class="panel-title">
            @(Model.ServiceId == 0
                ? Resources.AddService
                : Resources.EditService)
        </h3>

    </div>

    <div class="panel-body">

        @using (Html.BeginForm(
            "Save",
            "Service",
            FormMethod.Post,
            new { @class = "form-horizontal" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.ServiceId)


            <div class="form-group">

                @Html.LabelFor(
                    m => m.ServiceNameEN,
                    Resources.EnglishName,
                    new
                    {
                        @class = "col-sm-4 control-label"
                    })

                <div class="col-sm-8">

                    @Html.TextBoxFor(
                        m => m.ServiceNameEN,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ServiceNameEN,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.ServiceNameAR,
                    Resources.ArabicName,
                    new
                    {
                        @class = "col-sm-4 control-label"
                    })

                <div class="col-sm-8">

                    @Html.TextBoxFor(
                        m => m.ServiceNameAR,
                        new
                        {
                            @class = "form-control arabic-input"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ServiceNameAR,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.MaxTicketsPerDay,
                    Resources.MaxTicketsPerDay,
                    new
                    {
                        @class = "col-sm-4 control-label"
                    })

                <div class="col-sm-8">

                    @Html.TextBoxFor(
                        m => m.MaxTicketsPerDay,
                        new
                        {
                            @class = "form-control",
                            type = "number"
                        })

                    @Html.ValidationMessageFor(
                        m => m.MaxTicketsPerDay,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">



                <div class="col-sm-8">

                    <label class="checkbox-inline">

                        @Html.CheckBoxFor(
                            m => m.ServiceStatus)

                        @Resources.Active

                    </label>

                </div>

            </div>


            <div class="form-actions">

                @Html.ActionLink(
                    Resources.Cancel,
                    "Index",
                    "Dashboard",
                    null,
                    new
                    {
                        @class = "btn btn-default"
                    })

                <button type="submit"
                        class="btn btn-primary">
                    @Resources.Save
                </button>

            </div>
        }

    </div>

</div>


@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}