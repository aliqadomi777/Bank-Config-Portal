@using WebPortal.ASP.Resources
@model IEnumerable<WebPortal.ASP.Models.ServiceViewModel>

@{
    ViewBag.Title = Resources.ServicesManagement;

    int currentPage =
        ViewBag.CurrentPage != null
            ? (int)ViewBag.CurrentPage
            : 1;

    int totalPages =
        ViewBag.TotalPages != null
            ? (int)ViewBag.TotalPages
            : 0;
}


<div class="title">

    <h2>
        @Resources.ServicesManagement
    </h2>

</div>


<div class="panel panel-default management-panel">
    @Html.ActionLink(
    Resources.AddService,
    "Create",
    "Service",
    null,
    new
    {
        @class = "btn btn-primary btn-xs add-button-custom"
    })
    <div class="panel-body">

        <table class="table table-bordered table-striped management-table">

            <thead>

                <tr>

                    <th class="name-cell">
                        @Resources.EnglishName
                    </th>

                    <th class="name-cell">
                        @Resources.ArabicName
                    </th>

                    <th class="column-ticket-limit">
                        @Resources.MaxTicketsPerDay
                    </th>
                    <th>
                        @Resources.MinimumServiceTime
                    </th>
                    <th>
                        @Resources.MaximumServiceTime
                    </th>
                    <th class="column-status">
                        @Resources.Active
                    </th>

                    <th class="column-actions">

                        @Resources.Actions

                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var service in Model)
                {
                    <tr>

                        <td class="name-cell">
                            @service.ServiceNameEN
                        </td>

                        <td class="name-cell arabic-name">
                            @service.ServiceNameAR
                        </td>

                        <td>
                            @service.MaxTicketsPerDay
                        </td>
                        <td>
                            @service.MinimumServiceTime
                        </td>
                        <td>
                            @service.MaximumServiceTime
                        </td>
                        <td>
                            @(service.ServiceStatus
                                ? Resources.Yes
                                : Resources.No)
                        </td>

                        <td class="action-cell">

                            <div class="action-buttons">

                                @Html.ActionLink(
                                    Resources.Edit,
                                    "Edit",
                                    "Service",
                                    new
                                    {
                                        id = service.ServiceId
                                    },
                                    new
                                    {
                                        @class = "btn btn-warning btn-xs"
                                    })


                                @using (Html.BeginForm(
                                    "Delete",
                                    "Service",
                                    new
                                    {
                                        id = service.ServiceId
                                    },
                                    FormMethod.Post,
                                    new
                                    {

                                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-xs"
                                            onclick="return confirm('@Resources.ConfirmDelete');">

                                        @Resources.Delete

                                    </button>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        @if (totalPages > 1)
        {
            <div class="table-paging">

                @if (currentPage > 1)
                {
                    @Html.ActionLink(
                        Resources.Previous,
                        "Index",
                        "Service",
                        new
                        {
                            page = currentPage - 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }


                @for (int i = 1; i <= totalPages; i++)
                {
                    @Html.ActionLink(
                        i.ToString(),
                        "Index",
                        "Service",
                        new
                        {
                            page = i
                        },
                        new
                        {
                            @class =
                                i == currentPage
                                    ? "btn btn-primary btn-sm"
                                    : "btn btn-default btn-sm"
                        })
                }


                @if (currentPage < totalPages)
                {
                    @Html.ActionLink(
                        Resources.Next,
                        "Index",
                        "Service",
                        new
                        {
                            page = currentPage + 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }

            </div>
        }

    </div>

</div>

