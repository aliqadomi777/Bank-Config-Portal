@using WebPortal.ASP.Resources

@{
    ViewBag.Title = "Error";
}

<div class="title">
    <h2></h2>
</div>

<div class="panel panel-default form-panel">
    <div class="panel-body">
        <h2>@Resources.SomeThingWrongError</h2>
        <p>@Resources.GeneralError</p>

        @Html.ActionLink(
                 Resources.BackToDashboard,
                 "Index",
                 "Dashboard",
                 null,
                 new
                 {
                     @class =
                         "btn btn-primary btn-sm "
                 })
    </div>
</div>
