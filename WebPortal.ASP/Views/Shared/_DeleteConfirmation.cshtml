@using WebPortal.ASP.Resources
<div id="deleteOverlay" class="overlay">
    <div class="popup-box">
        <p>@Resources.ConfirmDelete</p>
        <div class="popup-buttons">
            <button type="button" id="confirmDeleteBtn" class="btn btn-danger btn-xs">@Resources.Yes</button>
            <button type="button" id="cancelDeleteBtn" class="btn btn-secondary btn-xs">@Resources.No</button>
        </div>
    </div>
</div>
