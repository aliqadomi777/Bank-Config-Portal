@using System.Security.Claims
@using WebPortal.ASP.Resources
@using WebPortal.ASP.Security

@{
    bool isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;


    ClaimsPrincipal claimsPrincipal = User as ClaimsPrincipal;

    string bankName =null;

    if (claimsPrincipal != null)
    {
        Claim bankNameClaim = claimsPrincipal.FindFirst(AuthenticationConstants.BankNameClaimType);

        if (bankNameClaim != null)
        {
            bankName = bankNameClaim.Value;
        }
    }
}

@{
    string currentLanguage = "en";

    if (Request.Cookies["Culture"] != null)
    {
        currentLanguage =
            Request.Cookies["Culture"].Value;
    }

    string controllerName =
        ViewContext.RouteData.Values["controller"]
            ?.ToString();

    string actionName =
        ViewContext.RouteData.Values["action"]
            ?.ToString();

    bool isLoginPage =
        (controllerName == "Login" &&
        actionName == "Index");
    bool isDashboardPage = (controllerName == "Dashboard" &&
            actionName == "Index");

    string languageReturnUrl =
ViewBag.LanguageReturnUrl != null
    ? ViewBag.LanguageReturnUrl.ToString()
    : Request.RawUrl;
}

<!DOCTYPE html>

<html lang="@currentLanguage"
      dir="@(currentLanguage == "ar" ? "rtl" : "ltr")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - @Resources.ApplicationName
    </title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")
    <link rel="stylesheet" href="~/Content/Site.css">


</head>

<body>

    <div class="header-container">

        <div class="language-container">

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "en",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "en" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                EN

            </a>

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "ar",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "ar" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                AR

            </a>

        </div>


        @if (isAuthenticated && !string.IsNullOrEmpty(bankName))
        {
            <h2>
                @bankName
            </h2>
        }
        else
        {
            <div class="bank-container"></div>
        }


        @if (!isLoginPage)
        {


            <div class="header-actions">
                @if (!isDashboardPage)
                {

                    @Html.ActionLink(
                        Resources.BackToDashboard,
                        "Index",
                        "Dashboard",
                        null,
                        new
                        {
                            @class =
                                "btn btn-primary btn-sm "
                        })
                }



                @using (Html.BeginForm(
                    "Logout",
                    "Login",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger btn-sm logout-button">

                        @Resources.Logout

                    </button>
                }

            </div>
        }
        else
        {
            <div class="header-actions"></div>
        }

    </div>


    <div class="container body-content">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">
                @TempData["Message"]
            </div>
        }

        @RenderBody()

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

    <script type="text/javascript">
        window.addEventListener('pageshow', function (event) {
            var isBackNavigation = event.persisted ||
                (window.performance && window.performance.navigation.type === 2);

            if (isBackNavigation) {
                document.body.style.display = 'none';
                window.location.reload();
            }
        });
    </script>


</body>

</html>