@using WebPortal.ASP.Resources

@{
    string currentLanguage = "en";

    if (Request.Cookies["Culture"] != null)
    {
        currentLanguage = Request.Cookies["Culture"].Value;
    }

    string controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    string actionName = ViewContext.RouteData.Values["action"]?.ToString();

    bool isLoginPage =
        controllerName == "Login" &&
        actionName == "Index";

    string languageReturnUrl =
    ViewBag.LanguageReturnUrl != null
        ? ViewBag.LanguageReturnUrl.ToString()
        : Request.RawUrl;
}

<!DOCTYPE html>

<html lang="@currentLanguage"
      dir="@(currentLanguage == "ar" ? "rtl" : "ltr")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - @Resources.ApplicationName
    </title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

    <style>

        body {
            background-color: #f5f5f5;
        }




        .title {
            text-align: center;
            margin-top: 30px;
            margin-bottom: 30px;
        }



        .header-container {
            display: flex;
            justify-content: space-between;
            margin: 10px;
        }

        .language-container {
            display: flex;
            justify-content: flex-end;
            direction: ltr;
        }

        .language-option {
            padding: 6px 12px;
            border: 1px solid #ccc;
            background: #fff;
            color: #555;
            text-decoration: none;
            font-size: 12px;
        }

            .language-option:hover {
                background: #f5f5f5;
                text-decoration: none;
                color: #333;
            }

            .language-option.active {
                background: #337ab7;
                border-color: #337ab7;
                color: #fff;
            }

        .logout-container {
            display: flex;
            justify-content: flex-end;
            direction: ltr;
        }

        .logout-button {
            min-width: 90px;
        }


        .management-table {
            width: 100%;
            table-layout: fixed;
        }

            .management-table th,
            .management-table td {
                vertical-align: middle;
                word-wrap: break-word;
                overflow-wrap: anywhere;
            }

        .name-cell {
            white-space: normal;
            word-break: break-word;
        }

        .arabic-name {
            direction: rtl;
            text-align: right;
        }

        .action-cell {
            padding: 5px !important;
        }

        .action-buttons {
            display: flex;
            flex-direction: row;
            gap: 4px;
        }

            .action-buttons .btn {
                flex: 1;
                text-align: center;
            }

        .add-button {
            display: block;
            width: 100%;
            text-align: center;
        }



        .table-paging {
            margin-top: 15px;
            text-align: center;
            direction: ltr;
        }

            .table-paging .btn {
                margin: 0 2px;
                min-width: 35px;
            }



        .form-panel {
            max-width: 700px;
            margin: 30px auto;
        }

            .form-panel .panel-body {
                padding: 25px;
            }

            .form-panel .form-group {
                margin-bottom: 20px;
            }

            .form-panel .control-label {
                white-space: nowrap;
            }

        .arabic-input {
            direction: rtl;
            text-align: right;
        }

        .form-buttons {
            margin-top: 25px;
            text-align: right;
        }

            .form-buttons .btn {
                min-width: 90px;
                margin-left: 5px;
            }

        html[dir="rtl"] .form-buttons {
            text-align: left;
        }

            html[dir="rtl"] .form-buttons .btn {
                margin-left: 0;
                margin-right: 5px;
            }

        .text-danger {
            display: block;
            margin-top: 5px;
        }



        .management-buttons {
            margin-top: 20px;
        }

        .back-button {
            min-width: 90px;
            text-align: center;
        }
    </style>

</head>

<body>

    <div class="header-container">

        <div class="language-container">

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "en",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "en" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                EN

            </a>

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "ar",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "ar" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                AR

            </a>

        </div>


        @if (!isLoginPage)
        {
            <div class="logout-container">

                @using (Html.BeginForm(
                    "Logout",
                    "Login",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger btn-sm logout-button">

                        @Resources.Logout

                    </button>
                }

            </div>
        }

    </div>


    <div class="container body-content">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">
                @TempData["Message"]
            </div>
        }

        @RenderBody()

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)


    <script>

        window.addEventListener("pageshow", function (event) {

            if (event.persisted) {
                window.location.reload();
            }

        });

    </script>

</body>

</html>