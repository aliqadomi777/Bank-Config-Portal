@using System.Security.Claims
@using WebPortal.ASP.Resources
@using WebPortal.ASP.Security

@{
    bool isAuthenticated =
        User != null &&
        User.Identity != null &&
        User.Identity.IsAuthenticated;


    ClaimsPrincipal claimsPrincipal = User as ClaimsPrincipal;

    string bankName = null;

    if (claimsPrincipal != null)
    {
        Claim bankNameClaim = claimsPrincipal.FindFirst(AuthenticationConstants.BankNameClaimType);

        if (bankNameClaim != null)
        {
            bankName = bankNameClaim.Value;
        }
    }
}

@{
    string currentLanguage = "en";

    if (Request.Cookies["Culture"] != null)
    {
        currentLanguage =
            Request.Cookies["Culture"].Value;
    }

    string controllerName =
        ViewContext.RouteData.Values["controller"]
            ?.ToString();

    string actionName =
        ViewContext.RouteData.Values["action"]
            ?.ToString();

    bool isLoginPage =
        (controllerName == "Login" &&
        actionName == "Index");
    bool isDashboardPage = (controllerName == "Dashboard" &&
            actionName == "Index");

    string languageReturnUrl =
ViewBag.LanguageReturnUrl != null
    ? ViewBag.LanguageReturnUrl.ToString()
    : Request.RawUrl;
}

<!DOCTYPE html>

<html lang="@currentLanguage"
      dir="@(currentLanguage == "ar" ? "rtl" : "ltr")">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewBag.Title - @Resources.ApplicationName
    </title>

    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")

</head>

<body>
    <script >
        (function () {
            const isLogin = @(isLoginPage ? "true" : "false");
            if (isLogin) return;
            const currentTabId = window.name;

            // Extract the server-side claim stored during login
            const activeServerTab = "@(claimsPrincipal?.FindFirst(AuthenticationConstants.ActiveTabId)?.Value ?? "")";
            const userIsAuthenticated = @(isAuthenticated ? "true" : "false");

            // FIREWALL TRIGGER: If the browser window tab memory doesn't match the server ticket,
            // or if the tab is opened cleanly but user authentication is missing -> REJECT
            if (!userIsAuthenticated || (activeServerTab && activeServerTab !== currentTabId)) {
                window.name = "";
                // Hard reset back to login page
                window.location.replace('@Url.Action("Index", "Login")');
            } else {
                // Authorized tab! Instantly drop the blinding CSS barrier
                const styleEl = document.getElementById("firewallStyle");
                if (styleEl) styleEl.remove();
            }
        })();
    </script>
    <div class="header-container">

        <div class="language-container">

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "en",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "en" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                EN

            </a>

            <a href="@Url.Action(
                        "ChangeLanguage",
                        "Language",
                        new
                        {
                            language = "ar",
                            returnUrl = languageReturnUrl
                        })"
               class="language-option @(currentLanguage == "ar" ? "active" : "")"
               onclick="window.location.replace(this.href); return false;">

                AR

            </a>

        </div>


        @if (isAuthenticated && !string.IsNullOrEmpty(bankName))
        {
            <div class="bank-container">
                <h2 dir="auto">
                    @bankName
                </h2>
            </div>
        }


        @if (!isLoginPage && isAuthenticated)
        {


            <div class="header-actions">
                @if (!isDashboardPage)
                {

                    @Html.ActionLink(
                             Resources.BackToDashboard,
                             "Index",
                             "Dashboard",
                             null,
                             new
                             {
                                 @class =
                                     "btn btn-primary btn-sm "
                             })
                }



                @using (Html.BeginForm(
                    "Logout",
                    "Login",
                    FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="btn btn-danger btn-sm logout-button">

                        @Resources.Logout

                    </button>
                }

            </div>
        }

    </div>


    <div class="container body-content">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">
                @TempData["Message"]
            </div>
        }

        @RenderBody()

    </div>


    @Scripts.Render("~/bundles/jquery")

    @Scripts.Render("~/bundles/bootstrap")

    @RenderSection("scripts", required: false)

    <script >
        window.addEventListener('pageshow', function (event) {
            var isBackNavigation = event.persisted ||
                (window.performance && window.performance.navigation.type === 2);

            if (isBackNavigation) {
                document.body.style.display = 'none';
                window.location.reload();
            }
        });
    </script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const overlay = document.getElementById("deleteOverlay");
            const cancelBtn = document.getElementById("cancelDeleteBtn");
            const confirmBtn = document.getElementById("confirmDeleteBtn");

            if (!overlay || !cancelBtn || !confirmBtn) {
                return;
            }

            let activeForm = null;

            document.addEventListener("click", function (event) {
                const deleteButton = event.target.closest(".open-delete-popup");

                if (!deleteButton) {
                    return;
                }

                activeForm = deleteButton.closest("form");
                overlay.style.display = "flex";
            });

            cancelBtn.addEventListener("click", function () {
                overlay.style.display = "none";
                activeForm = null;
            });

            confirmBtn.addEventListener("click", function () {
                if (activeForm) {
                    activeForm.submit();
                }
            });
        });
    </script>
    <script>
        //Maintain a clean, unique Tab ID hidden in window.name (Never shows up in URL)
        if (!window.name || !window.name.startsWith("TabID-")) {
            window.name = "TabID-" + Math.random().toString(36).substring(2, 15);
        }
        const currentTabId = window.name;

        //Drop a transient gatekeeper cookie right before the tab navigates to a new URL
        window.addEventListener("beforeunload", function () {
            document.cookie = "X-Tab-Gatekeeper=" + currentTabId + "; path=/; SameSite=Strict";
        });

        //Handle forms and link clicks directly just in case beforeunload is skipped
        document.addEventListener("submit", function () {
            document.cookie = "X-Tab-Gatekeeper=" + currentTabId + "; path=/; SameSite=Strict";
        });
        document.addEventListener("click", function (e) {
            if (e.target.closest("a")) {
                document.cookie = "X-Tab-Gatekeeper=" + currentTabId + "; path=/; SameSite=Strict";
            }
        });

        //Inject standard header specifically for AJAX request types
        const originalFetch = window.fetch;
        window.fetch = function (uri, options) {
            options = options || {};
            options.headers = options.headers || {};
            options.headers['X-Tab-Id'] = currentTabId;
            return originalFetch(uri, options);
        };
    </script>




</body>

</html>