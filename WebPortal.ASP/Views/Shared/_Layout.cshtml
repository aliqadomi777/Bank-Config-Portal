@{
    string currentLanguage = "en";

    if (Request.Cookies["Culture"] != null)
    {
        currentLanguage = Request.Cookies["Culture"].Value;
    }

}
<!DOCTYPE html>
<html lang="@currentLanguage" dir="@(currentLanguage == "ar" ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bank Portal</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    <style>
        body {
            background-color: #f5f5f5;
        }

        .login-wrapper {
            max-width: 420px;
            margin: 80px auto;
            padding: 30px;
            background: #fff;
            border-radius: 6px;
            box-shadow: 0 0 10px rgba(0,0,0,0.1);
        }

        .btn-custom-login {
            margin-top: 10px;
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 4px;
            cursor: pointer;
        }

            .btn-custom-login:hover {
                background-color: #0056b3;
            }

        .language-container {
            direction: ltr;
            display: flex;
            justify-content: flex-end;
            margin-top: 10px;
            margin-right: 10px;
            margin-bottom: 15px;
        }

        .language-option {
            padding: 6px 12px;
            border: 1px solid #ccc;
            background: #fff;
            color: #555;
            text-decoration: none;
            font-size: 12px;
        }

            .language-option:first-child {
                border-radius: 4px 0 0 4px;
            }

            .language-option:last-child {
                border-radius: 0 4px 4px 0;
                margin-left: -1px;
            }

            .language-option:hover {
                background: #f5f5f5;
                text-decoration: none;
                color: #333;
            }

            .language-option.active {
                background: #337ab7;
                border-color: #337ab7;
                color: #fff;
            }
    </style>
</head>
<body>
    <div class="language-container">

        <a href="@Url.Action("ChangeLanguage", "Language", new { language = "en", returnUrl = Request.RawUrl })"
           class="language-option @(currentLanguage == "en" ? "active" : "")"
           onclick="window.location.replace(this.href); return false;">
            EN
        </a>

        <a href="@Url.Action("ChangeLanguage", "Language", new { language = "ar", returnUrl = Request.RawUrl })"
           class="language-option @(currentLanguage == "ar" ? "active" : "")"
           onclick="window.location.replace(this.href); return false;">
            AR
        </a>

    </div>

    <div class="container body-content">
        @RenderBody()
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    @RenderSection("scripts", required: false)
</body>
</html>


<script>
    window.addEventListener("pageshow", function (event) {
        if (event.persisted) {
            window.location.reload();
        }
    });
</script>