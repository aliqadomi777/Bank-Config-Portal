@using WebPortal.ASP.Resources
@model IEnumerable<WebPortal.ASP.Models.CounterViewModel>

@{
    ViewBag.Title = Resources.CountersManagement;

    int currentPage =
        ViewBag.CurrentPage != null
            ? (int)ViewBag.CurrentPage
            : 1;

    int totalPages =
        ViewBag.TotalPages != null
            ? (int)ViewBag.TotalPages
            : 0;

    int branchId =
        ViewBag.BranchId != null
            ? (int)ViewBag.BranchId
            : 0;
}


<div class="title">

    <h2>
        @Resources.CountersManagement
    </h2>
    <hr />
    <h6 >
        @Resources.BranchName @ViewBag.BranchName
    </h6>

</div>


<div class="panel panel-default management-panel">
    @Html.ActionLink(
    Resources.AddCounter,
    "Create",
    "Counter",
    new
    {
        branchId = branchId
    },
    new
    {
        @class = "btn btn-primary btn-xs add-button-custom"
    })
    <div class="panel-body">

        <table class="table table-bordered table-striped management-table">

            <thead>

                <tr>

                    <th class="name-cell">
                        @Resources.EnglishName
                    </th>

                    <th class="name-cell">
                        @Resources.ArabicName
                    </th>

                    <th class="column-status">
                        @Resources.Active
                    </th>

                    <th class="column-counter-type">
                        @Resources.CounterType
                    </th>

                    <th class="column-services">
                        @Resources.Services
                    </th>

                    <th>

                        @Resources.Actions

                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var counter in Model)
                {
                    <tr>

                        <td class="name-cell">
                            @counter.CounterNameEN
                        </td>

                        <td class="name-cell arabic-name">
                            @counter.CounterNameAR
                        </td>

                        <td>
                            @(counter.CounterStatus
                                ? Resources.Yes
                                : Resources.No)
                        </td>

                        <td>
                            @counter.CounterTypeName
                        </td>

                        <td class="action-cell">

                            @Html.ActionLink(
                                Resources.ManageServiceAllocations,
                                "Index",
                                "Allocation",
                                new
                                {
                                    counterId = counter.CounterId
                                },
                                new
                                {
                                    @class = "btn btn-info btn-xs add-button"
                                })

                        </td>


                        <td class="action-cell">

                            <div class="action-buttons">

                                @Html.ActionLink(
                                    Resources.Edit,
                                    "Edit",
                                    "Counter",
                                    new
                                    {
                                        id = counter.CounterId
                                    },
                                    new
                                    {
                                        @class = "btn btn-warning btn-xs"
                                    })


                                @using (Html.BeginForm(
                                    "Delete",
                                    "Counter",
                                    new
                                    {
                                        id = counter.CounterId,
                                        branchId = branchId
                                    },
                                    FormMethod.Post,
                                    new
                                    {
                                    }))
                                {
                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-xs"
                                            onclick="return confirm('@Resources.ConfirmDelete');">

                                        @Resources.Delete

                                    </button>
                                }

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        @if (totalPages > 1)
        {
            <div class="table-paging">

                @if (currentPage > 1)
                {
                    @Html.ActionLink(
                        Resources.Previous,
                        "Index",
                        "Counter",
                        new
                        {
                            branchId = branchId,
                            page = currentPage - 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }


                @for (int i = 1; i <= totalPages; i++)
                {
                    @Html.ActionLink(
                        i.ToString(),
                        "Index",
                        "Counter",
                        new
                        {
                            branchId = branchId,
                            page = i
                        },
                        new
                        {
                            @class =
                                i == currentPage
                                    ? "btn btn-primary btn-sm"
                                    : "btn btn-default btn-sm"
                        })
                }


                @if (currentPage < totalPages)
                {
                    @Html.ActionLink(
                        Resources.Next,
                        "Index",
                        "Counter",
                        new
                        {
                            branchId = branchId,
                            page = currentPage + 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }

            </div>
        }


        <div class="management-buttons">

            @Html.ActionLink(
                Resources.BackToBranches,
                "Index",
                "Branch",
                null,
                new
                {
                    @class = "btn btn-primary btn-sm"
                })

        </div>

    </div>

</div>
