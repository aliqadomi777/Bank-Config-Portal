@using WebPortal.ASP.Resources
@model WebPortal.ASP.Models.AllocationFormViewModel

@{
    ViewBag.Title = Resources.AddAllocation;
}


<div class="title">

    <h2>
        @Resources.AddAllocation
    </h2>

</div>


<div class="panel panel-default form-panel">

    <div class="panel-body">

        @using (Html.BeginForm(
            "Save",
            "Allocation",
            FormMethod.Post,
            new
            {
                @class = "form-horizontal"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.CounterId)


            @Html.ValidationSummary(
                true,
                "",
                new
                {
                    @class = "text-danger"
                })


            <div class="form-group">

                @Html.LabelFor(
                    m => m.ServiceId,
                    Resources.Service,
                    new
                    {
                        @class = "col-sm-4 control-label"
                    })

                <div class="col-sm-8">

                    @Html.DropDownListFor(
                        m => m.ServiceId,
                        new SelectList(
                            Model.Services,
                            "ServiceId",
                            "ServiceName",
                            Model.ServiceId),
                        Resources.SelectService,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ServiceId,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-buttons">

                @Html.ActionLink(
                    Resources.Cancel,
                    "Index",
                    "Allocation",
                    new
                    {
                        counterId = Model.CounterId
                    },
                    new
                    {
                        @class = "btn btn-default"
                    })

                <button type="submit"
                        class="btn btn-primary">

                    @Resources.Add

                </button>

            </div>
        }

    </div>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}