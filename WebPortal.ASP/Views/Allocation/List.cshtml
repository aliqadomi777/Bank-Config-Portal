@using WebPortal.ASP.Resources
@model IEnumerable<WebPortal.ASP.Models.CounterServiceViewModel>

@{
    ViewBag.Title = Resources.AllocationsManagement;

    int currentPage =
        ViewBag.CurrentPage != null
            ? (int)ViewBag.CurrentPage
            : 1;

    int totalPages =
        ViewBag.TotalPages != null
            ? (int)ViewBag.TotalPages
            : 0;

    int counterId =
        ViewBag.CounterId != null
            ? (int)ViewBag.CounterId
            : 0;

    int branchId =
        ViewBag.BranchId != null
            ? (int)ViewBag.BranchId
            : 0;
}


<div class="title">



    <h2>
        @Resources.AllocationsManagement
    </h2>
    <hr />

        <h6>
            @Resources.BranchName @ViewBag.BranchName
        </h6>
        <h6>
            @Resources.CounterName @ViewBag.CounterName
        </h6>



</div>


<div class="panel panel-default management-panel">
    @Html.ActionLink(
    Resources.AddAllocation,
    "Create",
    "Allocation",
    new
    {
        counterId = counterId
    },
    new
    {
        @class = "btn btn-primary btn-xs add-button-custom"
    })


    <div class="panel-body">

        <table class="table table-bordered table-striped management-table">

            <thead>

                <tr>

                    <th class="name-cell">
                        @Resources.EnglishName
                    </th>

                    <th class="name-cell">
                        @Resources.ArabicName
                    </th>

                    <th class="column-actions">

                        @Resources.Actions
                    </th>

                </tr>

            </thead>


            <tbody>

                @foreach (var allocation in Model)
                {
                    <tr>

                        <td class="name-cell">
                            @allocation.ServiceNameEN
                        </td>

                        <td class="name-cell arabic-name">
                            @allocation.ServiceNameAR
                        </td>

                        <td class="action-cell">

                            @using (Html.BeginForm(
                                "Delete",
                                "Allocation",
                                new
                                {
                                    id = allocation.AllocationId,
                                    counterId = counterId
                                },
                                FormMethod.Post,
                                new
                                {
                                    style = "margin: 0;"
                                }))
                            {
                                @Html.AntiForgeryToken()

                                <button type="button" class="btn btn-danger btn-xs open-delete-popup">
                                    @Resources.Delete
                                </button>
                            }

                        </td>

                    </tr>
                }

            </tbody>

        </table>


        @if (totalPages > 1)
        {
            <div class="table-paging">

                @if (currentPage > 1)
                {
                    @Html.ActionLink(
                        Resources.Previous,
                        "Index",
                        "Allocation",
                        new
                        {
                            counterId = counterId,
                            page = currentPage - 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }


                @for (int i = 1; i <= totalPages; i++)
                {
                    @Html.ActionLink(
                        i.ToString(),
                        "Index",
                        "Allocation",
                        new
                        {
                            counterId = counterId,
                            page = i
                        },
                        new
                        {
                            @class =
                                i == currentPage
                                    ? "btn btn-primary btn-sm"
                                    : "btn btn-default btn-sm"
                        })
                }


                @if (currentPage < totalPages)
                {
                    @Html.ActionLink(
                        Resources.Next,
                        "Index",
                        "Allocation",
                        new
                        {
                            counterId = counterId,
                            page = currentPage + 1
                        },
                        new
                        {
                            @class = "btn btn-default btn-sm"
                        })
                }

            </div>
        }


        <div class="management-buttons">

            @Html.ActionLink(
                Resources.BackToCounters,
                "Index",
                "Counter",
                new
                {
                    branchId = branchId
                },
                new
                {
                    @class = "btn btn-primary btn-sm"
                })

        </div>

    </div>

</div>