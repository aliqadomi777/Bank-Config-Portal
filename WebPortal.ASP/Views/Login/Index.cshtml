@model WebPortal.ASP.Models.LoginViewModel
@using WebPortal.ASP.Resources

@{
    ViewBag.Title = Resources.Login;
}

<style>

    .login-wrapper {
        max-width: 420px;
        margin: 80px auto;
        padding: 30px;
        background: #fff;
        border-radius: 6px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

        .login-wrapper .control-label {
            white-space: nowrap;
        }

    .btn-custom-login {
        margin-top: 10px;
        background-color: #337ab7;
        color: #fff;
        border: none;
        padding: 10px 20px;
        font-size: 16px;
        border-radius: 4px;
    }

        .btn-custom-login:hover {
            background-color: #286090;
            color: #fff;
        }
</style>


<div class="title">

    <h2>
        @Resources.ApplicationName
    </h2>

</div>


<div class="login-wrapper">

    <section id="loginForm">

        @using (Html.BeginForm(
            "Login",
            "Login",
            FormMethod.Post,
            new
            {
                @class = "form-horizontal",
                role = "form"
            }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new
                {
                    @class = "text-danger"
                })


            <div class="form-group">

                @Html.LabelFor(
                    m => m.BankName,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.TextBoxFor(
                        m => m.BankName,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.BankName,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Username,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.TextBoxFor(
                        m => m.Username,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Username,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Password,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.PasswordFor(
                        m => m.Password,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Password,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                <div class="col-xs-offset-3 col-sm-offset-3 col-md-offset-3
                            col-xs-9 col-sm-9 col-md-9">

                    <button type="submit"
                            class="btn btn-custom-login">

                        @Resources.Login

                    </button>

                </div>

            </div>
        }

    </section>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}