@model WebPortal.ASP.Models.LoginViewModel
@using WebPortal.ASP.Resources

@{
    ViewBag.Title = Resources.Login;
}

@if (ViewBag.DbError != null)
{
    <div class="alert alert-danger">
        <strong>System Configuration Warning:</strong> @ViewBag.DbError
        <p>Please contact your system administrator. Login functionality is temporarily unavailable.</p>
    </div>
}



<div class="title">

    <h2>
        @Resources.ApplicationName
    </h2>

</div>


<div class="login-wrapper">

    <section id="loginForm">

        @using (Html.BeginForm(
            "Login",
            "Login",
            FormMethod.Post,
            new
            {
                @class = "form-horizontal",
                role = "form"
            }))
        {
            

            @Html.ValidationSummary(
                true,
                "",
                new
                {
                    @class = "text-danger"
                })


            <div class="form-group">

                @Html.LabelFor(
                    m => m.BankName,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.TextBoxFor(
                        m => m.BankName,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.BankName,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Username,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.TextBoxFor(
                        m => m.Username,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Username,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                @Html.LabelFor(
                    m => m.Password,
                    new
                    {
                        @class = "col-xs-3 col-sm-3 col-md-3 control-label text-right"
                    })

                <div class="col-xs-9 col-sm-9 col-md-9">

                    @Html.PasswordFor(
                        m => m.Password,
                        new
                        {
                            @class = "form-control"
                        })

                    @Html.ValidationMessageFor(
                        m => m.Password,
                        "",
                        new
                        {
                            @class = "text-danger"
                        })

                </div>

            </div>


            <div class="form-group">

                <div class="col-xs-offset-3 col-sm-offset-3 col-md-offset-3
                            col-xs-9 col-sm-9 col-md-9">

                    <button type="submit"
                            class="btn btn-custom-login"
                            @(ViewBag.DbError != null ? "disabled=disabled" : "")>

                        @Resources.Login

                    </button>

                </div>

            </div>
        }

    </section>

</div>


@section Scripts {

    @Scripts.Render("~/bundles/jqueryval")

}